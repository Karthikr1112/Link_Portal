# Django core settings
SECRET_KEY=change-me-generate-a-real-random-value
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database
# Leave DB_ENGINE unset (or anything other than "mysql") to use local SQLite.
# Set DB_ENGINE=mysql to switch to MySQL for production.
DB_ENGINE=mysql
DB_NAME=powerbi_portal
DB_USER=powerbi_portal
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# HTTPS / security (only applied when DEBUG=False)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
